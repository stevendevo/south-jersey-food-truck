# Required in production
NODE_ENV=production
SESSION_SECRET=            # long random string; signs form captcha challenges
ADMIN_TOKEN=               # long random string; /admin?token=...
DATA_DIR=/data             # Railway volume mount; seeded from ./data on first boot

# Email (event inquiries, contact, truck submissions)
RESEND_API_KEY=
EVENT_INQUIRY_RECIPIENT=grillycheese@grillycheese.net

# Optional: on-site AI assistant (disabled gracefully if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=
